// official/tokakv/cache/block_cache.tk
// Thread-safe in-memory BlockCache with pure owner ~CachedBlock / BlockLease RAII lifecycle.

import core/types::{usize}
import core/traits::{@Dup, @Encap}
import core/result::{Result}
import core/option::{Option}
import std/vec::{Vec}
import std/sync::{Mutex}
import std/data_file::{ReadDataFile}
import official/tokakv/types::{Entry, KvError, LookupResult}
import official/tokakv/memtable::{compare_internal_key}
import official/tokakv/sstable/block::{decode_and_validate_data_block}

/// CachedBlock: An immutable decoded data block residing in memory.
pub shape CachedBlock (
    file_number: u64,
    offset: u64,
    entries: Vec<Entry>,
    estimated_size_bytes: usize
)

impl CachedBlock@Encap {}
impl CachedBlock@Send {}
impl CachedBlock@Sync {}

impl CachedBlock {
    pub fn new(file_number: u64, offset: u64, cede entries: Vec<Entry>, estimated_size_bytes: usize) -> ~CachedBlock {
        auto ~blk = new CachedBlock(
            file_number = file_number,
            offset = offset,
            entries = cede entries,
            estimated_size_bytes = estimated_size_bytes
        )
        return cede ~blk
    }

    /// Performs safe binary search lookup for a specific sequence watermark within the block's entries.
    pub fn lookup_at_seq(self, key_slice: str, target_seq: u64) -> LookupResult {
        auto count = self.entries.len()
        if count == 0:usize {
            return LookupResult::NotFound
        }
        auto low# = 0:usize
        auto high# = count

        loop low < high {
            auto mid = low + ((high - low) / 2:usize)
            auto cmp# = 0:i32
            unsafe {
                auto *mid_entry = self.entries.unsafe_get(mid)
                cmp = compare_internal_key(key_slice, target_seq, mid_entry.key.as_str(), mid_entry.seq)
            }
            if cmp <= 0:i32 {
                high = mid
            } else {
                low = mid + 1:usize
            }
        }
        if low < count {
            unsafe {
                auto *e = self.entries.unsafe_get(low)
                if e.key.as_str().equals(key_slice) && e.seq <= target_seq {
                    if e.is_del {
                        return LookupResult::Deleted
                    } else {
                        return LookupResult::Hit(e.value.clone())
                    }
                }
            }
        }
        return LookupResult::NotFound
    }

    /// Performs safe binary search lookup within the block's entries without moving or exposing the Vec.
    pub fn lookup(self, key_slice: str) -> LookupResult {
        return self.lookup_at_seq(key_slice, 0xFFFFFFFFFFFFFFFF:u64)
    }

    pub fn file_number(self) -> u64 {
        return self.file_number
    }

    pub fn offset(self) -> u64 {
        return self.offset
    }

    pub fn estimated_size_bytes(self) -> usize {
        return self.estimated_size_bytes
    }
}

/// BlockLease: An active read-lease pinning a ~CachedBlock.
/// Memory remains valid as long as this lease is held, even if the block is evicted from the cache.
pub shape BlockLease (
    ~block: CachedBlock
)

impl BlockLease@Encap {}
impl BlockLease@Send {}
impl BlockLease@Sync {}

impl BlockLease {
    pub fn new(~block: CachedBlock) -> BlockLease {
        return BlockLease(~block = ~block)
    }

    /// Performs binary search lookup for a specific sequence watermark within the leased block.
    pub fn lookup_at_seq(self, key: str, target_seq: u64) -> LookupResult {
        return self.block.lookup_at_seq(key, target_seq)
    }

    /// Performs binary search lookup within the leased block without moving or exposing the internal Vec.
    pub fn lookup(self, key: str) -> LookupResult {
        return self.lookup_at_seq(key, 0xFFFFFFFFFFFFFFFF:u64)
    }

    pub fn estimated_size_bytes(self) -> usize {
        return self.block.estimated_size_bytes
    }
}

/// BlockEntry: An entry wrapper inside the LRU list holding a ~CachedBlock.
pub shape BlockEntry (
    ~block: CachedBlock
)

impl BlockEntry@Encap {}
impl BlockEntry@Send {}
impl BlockEntry@Sync {}

impl BlockEntry {
    pub fn new(~block: CachedBlock) -> BlockEntry {
        return BlockEntry(~block = ~block)
    }
}

impl BlockEntry@Dup {
    pub fn dup(self) -> Self {
        return BlockEntry(~block = self.~block)
    }
}

/// CacheStats: Performance counters and resident memory metrics.
pub shape CacheStats (
    resident_bytes: usize,
    capacity_bytes: usize,
    hit_count: u64,
    miss_count: u64,
    eviction_count: u64
)

impl CacheStats {
    pub fn new(resident_bytes: usize, capacity_bytes: usize, hit_count: u64, miss_count: u64, eviction_count: u64) -> CacheStats {
        return CacheStats(
            resident_bytes = resident_bytes,
            capacity_bytes = capacity_bytes,
            hit_count = hit_count,
            miss_count = miss_count,
            eviction_count = eviction_count
        )
    }

    pub fn estimated_resident_bytes(self) -> usize {
        return self.resident_bytes
    }
}

/// BlockCacheInner: Protected state inside Mutex.
pub shape BlockCacheInner (
    entries#: Vec<BlockEntry>,
    resident_bytes#: usize,
    capacity_bytes: usize,
    hit_count#: u64,
    miss_count#: u64,
    eviction_count#: u64
)

impl BlockCacheInner@Encap {}
impl BlockCacheInner@Send {}
impl BlockCacheInner@Sync {}

impl BlockCacheInner {
    pub fn new(capacity_bytes: usize) -> BlockCacheInner {
        return BlockCacheInner(
            entries = Vec<BlockEntry>::new(),
            resident_bytes = 0:usize,
            capacity_bytes = capacity_bytes,
            hit_count = 0:u64,
            miss_count = 0:u64,
            eviction_count = 0:u64
        )
    }

    /// Looks up a cached block by (file_number, offset). If found, promotes it to MRU (front).
    pub fn lookup_and_promote(self#, file_number: u64, offset: u64) -> Option<~CachedBlock> {
        auto count = self.entries.len()
        auto i# = 0:usize
        loop i < count {
            auto entry = self.entries.get(i)
            if entry.block.file_number == file_number && entry.block.offset == offset {
                self.hit_count = self.hit_count + 1:u64
                auto ~b = entry.~block
                if i > 0:usize {
                    auto hit_opt = self.entries#.remove(i)
                    if hit_opt.is_some() {
                        auto hit_val = hit_opt.unwrap()
                        self.entries#.insert(0:usize, cede hit_val)
                    }
                }
                return Option<~CachedBlock>::Some(~b)
            }
            i = i + 1:usize
        }
        self.miss_count = self.miss_count + 1:u64
        return Option<~CachedBlock>::None
    }

    /// Probes without counting miss (used for double-check before insertion).
    pub fn probe(self#, file_number: u64, offset: u64) -> Option<~CachedBlock> {
        auto count = self.entries.len()
        auto i# = 0:usize
        loop i < count {
            auto entry = self.entries.get(i)
            if entry.block.file_number == file_number && entry.block.offset == offset {
                auto ~b = entry.~block
                if i > 0:usize {
                    auto hit_opt = self.entries#.remove(i)
                    if hit_opt.is_some() {
                        auto hit_val = hit_opt.unwrap()
                        self.entries#.insert(0:usize, cede hit_val)
                    }
                }
                return Option<~CachedBlock>::Some(~b)
            }
            i = i + 1:usize
        }
        return Option<~CachedBlock>::None
    }

    /// Inserts a newly loaded block into MRU (index 0) and evicts LRU blocks (from tail)
    /// until resident_bytes <= capacity_bytes.
    pub fn insert_and_evict(self#, ~new_block: CachedBlock) {
        if self.capacity_bytes == 0:usize {
            return
        }
        if new_block.estimated_size_bytes > self.capacity_bytes {
            return
        }

        // Evict LRU items from the tail if adding new_block exceeds capacity
        loop self.entries.len() > 0:usize && (self.resident_bytes + new_block.estimated_size_bytes > self.capacity_bytes) {
            auto last_idx = self.entries.len() - 1:usize
            auto evicted_opt = self.entries#.remove(last_idx)
            if evicted_opt.is_some() {
                auto evicted = evicted_opt.unwrap()
                self.resident_bytes = self.resident_bytes - evicted.block.estimated_size_bytes
                self.eviction_count = self.eviction_count + 1:u64
            }
        }

        self.resident_bytes = self.resident_bytes + new_block.estimated_size_bytes
        auto entry = BlockEntry::new(~new_block)
        self.entries#.insert(0:usize, cede entry)
    }

    pub fn stats(self) -> CacheStats {
        return CacheStats::new(
            self.resident_bytes,
            self.capacity_bytes,
            self.hit_count,
            self.miss_count,
            self.eviction_count
        )
    }
}

/// BlockCache: Thread-safe entry point for block caching.
pub shape BlockCache (
    ~inner: Mutex<BlockCacheInner>,
    capacity_bytes: usize
)

impl BlockCache@Encap {
    fn drop(self#) {
    }
}
impl BlockCache@Send {}
impl BlockCache@Sync {}

impl BlockCache {
    pub fn new(capacity_bytes: usize) -> BlockCache {
        auto inner_val = BlockCacheInner::new(capacity_bytes)
        auto ~m = Mutex<BlockCacheInner>::make_shared(cede inner_val)
        return BlockCache(
            ~inner = ~m,
            capacity_bytes = capacity_bytes
        )
    }

    pub fn clone(self) -> BlockCache {
        return BlockCache(
            ~inner = self.~inner,
            capacity_bytes = self.capacity_bytes
        )
    }

    pub fn stats(self) -> CacheStats {
        auto lock_res = self.inner.lock()
        if lock_res.is_err() {
            return CacheStats::new(0:usize, self.capacity_bytes, 0:u64, 0:u64, 0:u64)
        }
        auto lock = lock_res.unwrap()
        auto &inner = lock.get_ref()
        return inner.stats()
    }

    /// Queries cache or loads from SSTable file on disk.
    /// Double-checks on insertion and never caches corrupted blocks / I/O errors.
    pub fn get_or_load(
        self,
        file_number: u64,
        offset: u64,
        length: u64,
        sst_path: string
    ) -> Result<BlockLease, KvError> {
        // 1. Initial lock probe
        {
            auto lock_res = self.inner.lock()
            if lock_res.is_ok() {
                auto lock = lock_res.unwrap()
                auto &inner# = lock.get_ref()
                auto hit_opt = inner#.lookup_and_promote(file_number, offset)
                if hit_opt.is_some() {
                    return Result<BlockLease, KvError>::Ok(BlockLease::new(hit_opt.unwrap()))
                }
            }
        }

        // 2. Cache miss: perform un-locked disk I/O and validation
        auto file_res = ReadDataFile::open(sst_path)
        if file_res.is_err() {
            return Result<BlockLease, KvError>::Err(KvError::io(file_res.unwrap_err()))
        }
        auto file = file_res.unwrap()

        auto blk_len = length as usize
        auto buf# = Vec<u8>::with_capacity(blk_len)
        auto read_res = file.read_at(cede buf, offset, blk_len)
        if read_res.is_err() {
            auto r_err = read_res.unwrap_err()
            return Result<BlockLease, KvError>::Err(KvError::io(r_err.error))
        }
        auto read_out = read_res.unwrap()
        if read_out.bytes_read != blk_len {
            return Result<BlockLease, KvError>::Err(KvError::corrupted("truncated_data_block_read"))
        }

        auto entries_res = decode_and_validate_data_block(read_out.take_buffer(), length)
        if entries_res.is_err() {
            return Result<BlockLease, KvError>::Err(entries_res.unwrap_err())
        }
        auto entries = entries_res.unwrap()

        // Approximate in-memory size of decoded block (estimated_resident_bytes)
        auto approx_size# = blk_len + (entries.len() * 32:usize)
        auto i# = 0:usize
        loop i < entries.len() {
            auto entry = entries.get(i)
            approx_size = approx_size + entry.key.len() + entry.value.len()
            i = i + 1:usize
        }

        auto ~new_block = CachedBlock::new(file_number, offset, cede entries, approx_size)

        // 3. Re-acquire lock for double-check insertion
        auto lock_res2 = self.inner.lock()
        if lock_res2.is_ok() {
            auto lock2 = lock_res2.unwrap()
            auto &inner2# = lock2.get_ref()
            // Double-check if another concurrent worker inserted it while we were reading disk
            auto peer_hit_opt = inner2#.probe(file_number, offset)
            if peer_hit_opt.is_some() {
                // Return the existing resident block; ~new_block drops automatically
                return Result<BlockLease, KvError>::Ok(BlockLease::new(peer_hit_opt.unwrap()))
            }

            // Insert into cache (handles eviction if needed)
            inner2#.insert_and_evict(~new_block)
        }

        return Result<BlockLease, KvError>::Ok(BlockLease::new(~new_block))
    }
}

impl BlockCache@Dup {
    pub fn dup(self) -> Self {
        return self.clone()
    }
}
