// official/tokakv/sstable/block.tk
// Block encoders, decoders, CRC32 verification, and binary search helpers for SSTables.

import core/types::{usize}
import core/traits::{@Dup}
import core/result::{Result}
import core/option::{Option}
import std/vec::{Vec}
import official/tokakv/types::{Entry, KvError, LookupResult}
import official/tokakv/crc32::{crc32_ieee}
import official/tokakv/memtable::{compare_internal_key}
import official/tokakv/sstable/format::{
    IndexEntry, MAX_BLOCK_SIZE,
    put_u32_le, put_u64_le, get_u32_le, get_u64_le
}
import sys/libc::{libc_printf}

/// Encodes sorted data entries into a data block with 8-byte CRC32 and DataLength header.
pub fn encode_data_block(entries: Vec<Entry>) -> Result<Vec<u8>, KvError> {
    auto count = entries.len()
    if count == 0:usize {
        return Result<Vec<u8>, KvError>::Err(KvError::corrupted("empty_data_block_not_allowed"))
    }

    auto payload# = Vec<u8>::new()
    put_u32_le(payload#, count as u32)

    auto i# = 0:usize
    loop i < count {
        auto &entry = entries.borrow(i)
        // Verify internal key monotonicity
        if i > 0:usize {
            auto &prev = entries.borrow(i - 1:usize)
            auto cmp = compare_internal_key(prev.key.as_str(), prev.seq, entry.key.as_str(), entry.seq)
            if cmp >= 0:i32 {
                return Result<Vec<u8>, KvError>::Err(KvError::corrupted("non_monotonic_data_block_keys"))
            }
        }

        auto klen = entry.key.len()
        auto vlen# = 0:usize
        if !entry.is_del {
            vlen = entry.value.len()
        }

        if entry.is_del {
            payload#.push(1:u8)
        } else {
            payload#.push(0:u8)
        }

        put_u64_le(payload#, entry.seq)
        put_u32_le(payload#, klen as u32)

        if klen > 0:usize {
            unsafe {
                auto *k_bytes = (entry.key.c_str() as usize) as *[u8]
                auto k# = 0:usize
                loop k < klen {
                    payload#.push(k_bytes[k])
                    k = k + 1:usize
                }
            }
        }

        put_u32_le(payload#, vlen as u32)
        if vlen > 0:usize {
            unsafe {
                auto *v_bytes = (entry.value.c_str() as usize) as *[u8]
                auto v# = 0:usize
                loop v < vlen {
                    payload#.push(v_bytes[v])
                    v = v + 1:usize
                }
            }
        }

        i = i + 1:usize
    }

    auto data_len = payload.len()
    if data_len > MAX_BLOCK_SIZE {
        return Result<Vec<u8>, KvError>::Err(KvError::record_too_large(data_len, MAX_BLOCK_SIZE))
    }

    auto block_buf# = Vec<u8>::with_capacity(8:usize + data_len)
    auto crc = crc32_ieee(payload, 0:usize, data_len)
    put_u32_le(block_buf#, crc)
    put_u32_le(block_buf#, data_len as u32)

    auto p# = 0:usize
    loop p < data_len {
        block_buf#.push(payload.get(p))
        p = p + 1:usize
    }

    return Result<Vec<u8>, KvError>::Ok(cede block_buf)
}

/// Decodes and validates a data block buffer against expected physical length and internal CRC.
pub fn decode_and_validate_data_block(buf: Vec<u8>, expected_len: u64) -> Result<Vec<Entry>, KvError> {
    if expected_len < 8:u64 || buf.len() as u64 != expected_len {
        return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("data_block_length_mismatch"))
    }

    auto recorded_crc = get_u32_le(buf, 0:usize)
    auto data_len = get_u32_le(buf, 4:usize) as usize

    auto total_len = (8:usize + data_len) as u64
    if total_len != expected_len {
        return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("data_block_declared_length_mismatch"))
    }

    auto actual_crc = crc32_ieee(buf, 8:usize, data_len)
    if actual_crc != recorded_crc {
        return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("data_block_crc_mismatch"))
    }

    auto entries# = Vec<Entry>::new()
    if data_len < 4:usize {
        return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("truncated_data_block_payload"))
    }

    auto count = get_u32_le(buf, 8:usize) as usize
    auto cursor# = 12:usize
    auto total_end = 8:usize + data_len

    auto i# = 0:usize
    loop i < count {
        if cursor + 17:usize > total_end {
            return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("data_block_entry_header_truncated"))
        }

        auto tag = buf.get(cursor)
        auto is_del = (tag == 1:u8)
        cursor = cursor + 1:usize

        auto seq = get_u64_le(buf, cursor)
        cursor = cursor + 8:usize

        auto klen = get_u32_le(buf, cursor) as usize
        cursor = cursor + 4:usize

        if cursor + klen > total_end {
            return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("data_block_entry_key_truncated"))
        }

        auto key# = string::new()
        if klen > 0:usize {
            auto *k_ptr = buf.unsafe_get(cursor)
            key = string::from_raw(*k_ptr, klen)
            cursor = cursor + klen
        }

        if cursor + 4:usize > total_end {
            return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("data_block_entry_vlen_truncated"))
        }
        auto vlen = get_u32_le(buf, cursor) as usize
        cursor = cursor + 4:usize

        if cursor + vlen > total_end {
            return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("data_block_entry_val_truncated"))
        }

        auto value# = string::new()
        if vlen > 0:usize {
            auto *v_ptr = buf.unsafe_get(cursor)
            value = string::from_raw(*v_ptr, vlen)
            cursor = cursor + vlen
        }

        // Validate internal key monotonicity
        if entries.len() > 0:usize {
            auto &prev = entries.borrow(entries.len() - 1:usize)
            auto cmp = compare_internal_key(prev.key.as_str(), prev.seq, key.as_str(), seq)
            if cmp >= 0:i32 {
                return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("non_monotonic_keys_in_data_block"))
            }
        }

        if is_del {
            entries#.push(Entry::new_delete(cede key, seq))
        } else {
            entries#.push(Entry::new_put(cede key, cede value, seq))
        }

        i = i + 1:usize
    }

    if cursor != total_end {
        return Result<Vec<Entry>, KvError>::Err(KvError::corrupted("trailing_garbage_in_data_block"))
    }

    return Result<Vec<Entry>, KvError>::Ok(cede entries)
}

/// Binary search for an exact key inside a decoded data block.
pub fn find_entry_in_block(entries: Vec<Entry>, key_slice: str) -> LookupResult {
    return find_entry_in_block_at_seq(entries, key_slice, 0xFFFFFFFFFFFFFFFF:u64)
}

pub fn find_entry_in_block_at_seq(entries: Vec<Entry>, key_slice: str, target_seq: u64) -> LookupResult {
    auto count = entries.len()
    if count == 0:usize {
        return LookupResult::NotFound
    }
    auto low# = 0:usize
    auto high# = count

    loop low < high {
        auto mid = low + ((high - low) / 2:usize)
        auto mid_entry = entries.get(mid)
        auto c = compare_internal_key(key_slice, target_seq, mid_entry.key.as_str(), mid_entry.seq)
        if c <= 0:i32 {
            high = mid
        } else {
            low = mid + 1:usize
        }
    }
    if low < count {
        auto e = entries.get(low)
        if e.key.as_str().equals(key_slice) && e.seq <= target_seq {
            if e.is_del {
                return LookupResult::Deleted
            } else {
                return LookupResult::Hit(e.value.clone())
            }
        }
    }
    return LookupResult::NotFound
}

/// Encodes sorted IndexEntry list into an index block with 8-byte CRC32 and DataLength header.
pub fn encode_index_block(entries: Vec<IndexEntry>) -> Result<Vec<u8>, KvError> {
    auto count = entries.len()
    if count == 0:usize {
        return Result<Vec<u8>, KvError>::Err(KvError::corrupted("empty_index_block_not_allowed"))
    }

    auto payload# = Vec<u8>::new()
    put_u32_le(payload#, count as u32)

    auto i# = 0:usize
    loop i < count {
        auto &entry = entries.borrow(i)
        // Verify last_key monotonicity
        if i > 0:usize {
            auto &prev = entries.borrow(i - 1:usize)
            if prev.last_key.as_str().cmp(entry.last_key.as_str()) >= 0:i32 {
                return Result<Vec<u8>, KvError>::Err(KvError::corrupted("non_monotonic_index_last_keys"))
            }
        }

        auto klen = entry.last_key.len()
        put_u32_le(payload#, klen as u32)
        if klen > 0:usize {
            unsafe {
                auto *k_bytes = (entry.last_key.c_str() as usize) as *[u8]
                auto k# = 0:usize
                loop k < klen {
                    payload#.push(k_bytes[k])
                    k = k + 1:usize
                }
            }
        }
        put_u64_le(payload#, entry.offset)
        put_u64_le(payload#, entry.length)
        i = i + 1:usize
    }

    auto data_len = payload.len()
    if data_len > MAX_BLOCK_SIZE {
        return Result<Vec<u8>, KvError>::Err(KvError::corrupted("index_block_exceeds_max_block_size"))
    }

    auto block_buf# = Vec<u8>::with_capacity(8:usize + data_len)
    auto crc = crc32_ieee(payload, 0:usize, data_len)
    put_u32_le(block_buf#, crc)
    put_u32_le(block_buf#, data_len as u32)

    auto p# = 0:usize
    loop p < data_len {
        block_buf#.push(payload.get(p))
        p = p + 1:usize
    }

    return Result<Vec<u8>, KvError>::Ok(cede block_buf)
}

/// Decodes and validates an index block against expected length, offset, and CRC.
pub fn decode_and_validate_index_block(
    buf: Vec<u8>,
    expected_len: u64,
    index_offset: u64
) -> Result<Vec<IndexEntry>, KvError> {
    if expected_len < 8:u64 || buf.len() as u64 != expected_len {
        return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("index_block_length_mismatch"))
    }

    auto recorded_crc = get_u32_le(buf, 0:usize)
    auto data_len = get_u32_le(buf, 4:usize) as usize

    auto total_len = (8:usize + data_len) as u64
    if total_len != expected_len {
        return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("index_block_declared_length_mismatch"))
    }

    auto actual_crc = crc32_ieee(buf, 8:usize, data_len)
    if actual_crc != recorded_crc {
        return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("index_block_crc_mismatch"))
    }

    auto entries# = Vec<IndexEntry>::new()
    if data_len < 4:usize {
        return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("truncated_index_block_payload"))
    }

    auto count = get_u32_le(buf, 8:usize) as usize
    auto cursor# = 12:usize
    auto total_end = 8:usize + data_len

    auto i# = 0:usize
    loop i < count {
        if cursor + 4:usize > total_end {
            return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("index_block_entry_truncated_key_len"))
        }

        auto klen = get_u32_le(buf, cursor) as usize
        cursor = cursor + 4:usize

        if cursor + klen + 16:usize > total_end {
            return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("index_block_entry_truncated_body"))
        }

        auto last_key# = string::new()
        if klen > 0:usize {
            auto *k_ptr = buf.unsafe_get(cursor)
            last_key = string::from_raw(*k_ptr, klen)
            cursor = cursor + klen
        }

        auto blk_offset = get_u64_le(buf, cursor)
        auto blk_length = get_u64_le(buf, cursor + 8:usize)
        cursor = cursor + 16:usize

        if blk_length < 8:u64 {
            return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("index_block_entry_length_too_small"))
        }

        // Validate continuity: Block 0 starts at 0, subsequent blocks start at prev.offset + prev.length
        if entries.len() == 0:usize {
            if blk_offset != 0:u64 {
                return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("first_data_block_offset_not_zero"))
            }
        } else {
            auto &prev = entries.borrow(entries.len() - 1:usize)
            if prev.last_key.as_str().cmp(last_key.as_str()) >= 0:i32 {
                return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("non_monotonic_index_last_keys"))
            }
            if blk_offset != prev.offset + prev.length {
                return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("non_contiguous_data_blocks"))
            }
        }

        entries#.push(IndexEntry::new(cede last_key, blk_offset, blk_length))
        i = i + 1:usize
    }

    if cursor != total_end {
        return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("trailing_garbage_in_index_block"))
    }

    // Verify that the last block ends exactly at index_offset
    {
        auto &last_entry = entries.borrow(entries.len() - 1:usize)
        if last_entry.offset + last_entry.length != index_offset {
            return Result<Vec<IndexEntry>, KvError>::Err(KvError::corrupted("data_blocks_do_not_abut_index_block"))
        }
    }

    return Result<Vec<IndexEntry>, KvError>::Ok(cede entries)
}

/// Binary search on IndexEntry list to find the candidate data block whose last_key >= key.
pub fn find_candidate_block(index_entries: Vec<IndexEntry>, key: string) -> Option<IndexEntry> {
    auto count = index_entries.len()
    if count == 0:usize {
        return Option<IndexEntry>::None
    }

    auto low# = 0:usize
    auto high# = count

    loop low < high {
        auto mid = low + ((high - low) / 2:usize)
        auto &entry = index_entries.borrow(mid)
        if entry.last_key.as_str().cmp(key.as_str()) < 0:i32 {
            low = mid + 1:usize
        } else {
            high = mid
        }
    }

    if low < count {
        auto &candidate = index_entries.borrow(low)
        auto lk = candidate.last_key.clone()
        return Option<IndexEntry>::Some(IndexEntry::new(cede lk, candidate.offset, candidate.length))
    }
    return Option<IndexEntry>::None
}
