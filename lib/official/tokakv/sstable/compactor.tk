// official/tokakv/sstable/compactor.tk
// Deterministic Level-0 compaction pipeline and sequence deduplicator.

import core/types::{usize}
import core/result::{Result}
import core/option::{Option}
import std/vec::{Vec}
import official/tokakv/types::{Entry, KvError}
import official/tokakv/manifest/version::{TableMetadata, TableHandle, Version}
import official/tokakv/manifest/version_set::{VersionSet, build_table_path}
import official/tokakv/sstable/iterator::{SSTableIterator}
import official/tokakv/sstable/merger::{MergingIterator}
import official/tokakv/sstable/writer::{SSTableWriter}

pub shape CompactionPlan (
    input_l0_handles: Vec<TableHandle>,
    input_l1_handles: Vec<TableHandle>,
    untouched_l1_handles: Vec<TableHandle>,
    old_file_numbers: Vec<u64>,
    l0_min_key: string,
    l0_max_key: string
)

impl CompactionPlan {
    /// Builds a full L0 + overlapping L1 compaction plan from current Version.
    pub fn build(cur_ver: Version) -> Option<CompactionPlan> {
        auto input_l0_handles# = Vec<TableHandle>::new()
        auto input_l1_handles# = Vec<TableHandle>::new()
        auto untouched_l1_handles# = Vec<TableHandle>::new()
        auto old_file_numbers# = Vec<u64>::new()

        auto l0_min_key# = string::new()
        auto l0_max_key# = string::new()
        auto has_l0# = false

        auto count = cur_ver.tables_count()
        auto i# = 0:usize
        loop i < count {
            auto h = cur_ver.get_table(i)
            if h.meta.level == 0:u32 {
                if !has_l0 {
                    has_l0 = true
                    l0_min_key = h.meta.smallest_key.clone()
                    l0_max_key = h.meta.largest_key.clone()
                } else {
                    if h.meta.smallest_key.as_str().cmp(l0_min_key.as_str()) < 0:i32 {
                        l0_min_key = h.meta.smallest_key.clone()
                    }
                    if h.meta.largest_key.as_str().cmp(l0_max_key.as_str()) > 0:i32 {
                        l0_max_key = h.meta.largest_key.clone()
                    }
                }
                old_file_numbers#.push(h.meta.file_number)
                input_l0_handles#.push(cede h)
            }
            i = i + 1:usize
        }

        if !has_l0 {
            return Option<CompactionPlan>::None
        }

        // Partition Level 1 tables into overlapping vs untouched
        auto j# = 0:usize
        loop j < count {
            auto h = cur_ver.get_table(j)
            if h.meta.level == 1:u32 {
                auto is_overlapping# = false
                if h.meta.largest_key.as_str().cmp(l0_min_key.as_str()) >= 0:i32 && h.meta.smallest_key.as_str().cmp(l0_max_key.as_str()) <= 0:i32 {
                    is_overlapping = true
                }
                if is_overlapping {
                    old_file_numbers#.push(h.meta.file_number)
                    input_l1_handles#.push(cede h)
                } else {
                    untouched_l1_handles#.push(cede h)
                }
            }
            j = j + 1:usize
        }

        return Option<CompactionPlan>::Some(CompactionPlan(
            input_l0_handles = cede input_l0_handles,
            input_l1_handles = cede input_l1_handles,
            untouched_l1_handles = cede untouched_l1_handles,
            old_file_numbers = cede old_file_numbers,
            l0_min_key = cede l0_min_key,
            l0_max_key = cede l0_max_key
        ))
    }
}

pub shape Compactor ()

impl Compactor {
    /// Filters a descending-sequence group of entries for a single user key according to whole-group tombstone GC policy.
    pub fn filter_user_key_group(
        group: Vec<Entry>,
        oldest_snapshot_opt: Option<u64>
    ) -> Vec<Entry> {
        auto kept# = Vec<Entry>::new()
        auto group_len = group.len()
        if group_len == 0:usize {
            return kept
        }

        if oldest_snapshot_opt.is_some() {
            auto min_snap = oldest_snapshot_opt.unwrap()
            auto seen_below# = false
            auto i# = 0:usize
            loop i < group_len {
                {
                    auto &group_entry = group.borrow(i)
                    if group_entry.seq >= min_snap {
                        auto e = Entry(
                            key = group_entry.key.clone(),
                            value = group_entry.value.clone(),
                            seq = group_entry.seq,
                            is_del = group_entry.is_del
                        )
                        kept#.push(cede e)
                    } else {
                        if !seen_below {
                            seen_below = true
                            if !group_entry.is_del {
                                auto e = Entry(
                                    key = group_entry.key.clone(),
                                    value = group_entry.value.clone(),
                                    seq = group_entry.seq,
                                    is_del = group_entry.is_del
                                )
                                kept#.push(cede e)
                            }
                        }
                    }
                }
                i = i + 1:usize
            }
        } else {
            // No snapshots active: only inspect the highest-sequence entry
            {
                auto &first_group_entry = group.borrow(0:usize)
                if !first_group_entry.is_del {
                    auto e = Entry(
                        key = first_group_entry.key.clone(),
                        value = first_group_entry.value.clone(),
                        seq = first_group_entry.seq,
                        is_del = first_group_entry.is_del
                    )
                    kept#.push(cede e)
                }
            }
        }

        return kept
    }

    /// Merges multiple SSTables according to CompactionPlan, streaming outputs into Level 1 SSTables.
    pub fn compact_plan(
        db_dir: string,
        plan: CompactionPlan,
        version_set#: VersionSet,
        oldest_snapshot_opt: Option<u64>,
        target_table_bytes: usize
    ) -> Result<Vec<TableMetadata>, KvError> {
        auto total_inputs = plan.input_l0_handles.len() + plan.input_l1_handles.len()
        if total_inputs == 0:usize {
            return Result<Vec<TableMetadata>, KvError>::Ok(Vec<TableMetadata>::new())
        }

        // 1. Open streaming iterators for all source SSTables
        auto iters# = Vec<SSTableIterator>::with_capacity(total_inputs)
        auto l0_i# = 0:usize
        loop l0_i < plan.input_l0_handles.len() {
            {
                auto &l0_handle = plan.input_l0_handles.borrow(l0_i)
                auto it_res = SSTableIterator::open(l0_handle.reader)
                if it_res.is_err() {
                    return Result<Vec<TableMetadata>, KvError>::Err(it_res.unwrap_err())
                }
                auto it = it_res.unwrap()
                iters#.push(cede it)
            }
            l0_i = l0_i + 1:usize
        }

        auto l1_i# = 0:usize
        loop l1_i < plan.input_l1_handles.len() {
            {
                auto &l1_handle = plan.input_l1_handles.borrow(l1_i)
                auto it_res = SSTableIterator::open(l1_handle.reader)
                if it_res.is_err() {
                    return Result<Vec<TableMetadata>, KvError>::Err(it_res.unwrap_err())
                }
                auto it = it_res.unwrap()
                iters#.push(cede it)
            }
            l1_i = l1_i + 1:usize
        }

        // 2. Build multi-way merging iterator
        auto merger# = MergingIterator::new(cede iters)

        // 3. Whole-group user-key stream processing & multi-SSTable chunking on key boundaries
        auto emitted_tables# = Vec<TableMetadata>::new()
        auto current_chunk# = Vec<Entry>::new()
        auto current_chunk_bytes# = 0:usize

        auto current_group# = Vec<Entry>::new()
        auto current_key# = string::new()
        auto has_key# = false

        loop merger#.is_valid() {
            auto n_res = merger#.next_entry()
            if n_res.is_err() {
                return Result<Vec<TableMetadata>, KvError>::Err(n_res.unwrap_err())
            }
            auto opt = n_res.unwrap()
            if opt.is_none() {
                break
            }
            auto entry = opt.unwrap()

            if has_key && !entry.key.as_str().equals(current_key.as_str()) {
                // Process previous group
                auto kept_entries# = Compactor::filter_user_key_group(current_group, oldest_snapshot_opt)
                if kept_entries.len() > 0:usize {
                    auto group_bytes# = 0:usize
                    auto g_i# = 0:usize
                    loop g_i < kept_entries.len() {
                        {
                            auto &kept_size_entry = kept_entries.borrow(g_i)
                            group_bytes = group_bytes + kept_size_entry.key.len() + kept_size_entry.value.len() + 16:usize
                        }
                        g_i = g_i + 1:usize
                    }

                    if current_chunk_bytes >= target_table_bytes && current_chunk.len() > 0:usize {
                        // Flush current_chunk to a new L1 SSTable
                        auto alloc_res = version_set#.durable_allocate_file_number()
                        if alloc_res.is_err() {
                            return Result<Vec<TableMetadata>, KvError>::Err(alloc_res.unwrap_err())
                        }
                        auto new_num = alloc_res.unwrap()
                        auto t_path = build_table_path(db_dir.clone(), new_num)
                        auto w_res = SSTableWriter::write_entries(t_path, current_chunk)
                        if w_res.is_err() {
                            return Result<Vec<TableMetadata>, KvError>::Err(w_res.unwrap_err())
                        }
                        auto meta# = w_res.unwrap()
                        meta.file_number = new_num
                        meta.level = 1:u32
                        emitted_tables#.push(cede meta)
                        current_chunk = Vec<Entry>::new()
                        current_chunk_bytes = 0:usize
                    }

                    auto k_i# = 0:usize
                    loop k_i < kept_entries.len() {
                        {
                            auto &kept_copy_entry = kept_entries.borrow(k_i)
                            auto e = Entry(
                                key = kept_copy_entry.key.clone(),
                                value = kept_copy_entry.value.clone(),
                                seq = kept_copy_entry.seq,
                                is_del = kept_copy_entry.is_del
                            )
                            current_chunk#.push(cede e)
                        }
                        k_i = k_i + 1:usize
                    }
                    current_chunk_bytes = current_chunk_bytes + group_bytes
                }
                current_group = Vec<Entry>::new()
                current_key = entry.key.clone()
            }

            if !has_key {
                has_key = true
                current_key = entry.key.clone()
            }
            current_group#.push(cede entry)
        }

        // Process final group
        if current_group.len() > 0:usize {
            auto kept_entries# = Compactor::filter_user_key_group(current_group, oldest_snapshot_opt)
            if kept_entries.len() > 0:usize {
                auto group_bytes# = 0:usize
                auto g_i# = 0:usize
                loop g_i < kept_entries.len() {
                    {
                        auto &final_size_entry = kept_entries.borrow(g_i)
                        group_bytes = group_bytes + final_size_entry.key.len() + final_size_entry.value.len() + 16:usize
                    }
                    g_i = g_i + 1:usize
                }

                if current_chunk_bytes >= target_table_bytes && current_chunk.len() > 0:usize {
                    auto alloc_res = version_set#.durable_allocate_file_number()
                    if alloc_res.is_err() {
                        return Result<Vec<TableMetadata>, KvError>::Err(alloc_res.unwrap_err())
                    }
                    auto new_num = alloc_res.unwrap()
                    auto t_path = build_table_path(db_dir.clone(), new_num)
                    auto w_res = SSTableWriter::write_entries(t_path, current_chunk)
                    if w_res.is_err() {
                        return Result<Vec<TableMetadata>, KvError>::Err(w_res.unwrap_err())
                    }
                    auto meta# = w_res.unwrap()
                    meta.file_number = new_num
                    meta.level = 1:u32
                    emitted_tables#.push(cede meta)
                    current_chunk = Vec<Entry>::new()
                    current_chunk_bytes = 0:usize
                }

                auto k_i# = 0:usize
                loop k_i < kept_entries.len() {
                    {
                        auto &final_copy_entry = kept_entries.borrow(k_i)
                        auto e = Entry(
                            key = final_copy_entry.key.clone(),
                            value = final_copy_entry.value.clone(),
                            seq = final_copy_entry.seq,
                            is_del = final_copy_entry.is_del
                        )
                        current_chunk#.push(cede e)
                    }
                    k_i = k_i + 1:usize
                }
                current_chunk_bytes = current_chunk_bytes + group_bytes
            }
        }

        // Flush remaining entries in current_chunk
        if current_chunk.len() > 0:usize {
            auto alloc_res = version_set#.durable_allocate_file_number()
            if alloc_res.is_err() {
                return Result<Vec<TableMetadata>, KvError>::Err(alloc_res.unwrap_err())
            }
            auto new_num = alloc_res.unwrap()
            auto t_path = build_table_path(db_dir.clone(), new_num)
            auto w_res = SSTableWriter::write_entries(t_path, current_chunk)
            if w_res.is_err() {
                return Result<Vec<TableMetadata>, KvError>::Err(w_res.unwrap_err())
            }
            auto meta# = w_res.unwrap()
            meta.file_number = new_num
            meta.level = 1:u32
            emitted_tables#.push(cede meta)
        }

        return Result<Vec<TableMetadata>, KvError>::Ok(cede emitted_tables)
    }

    /// Legacy compat method.
    pub fn compact_tables(
        db_dir: string,
        old_handles: Vec<TableHandle>,
        new_file_number: u64,
        oldest_snapshot_opt: Option<u64>
    ) -> Result<TableMetadata, KvError> {
        auto old_count = old_handles.len()
        if old_count == 0:usize {
            return Result<TableMetadata, KvError>::Err(KvError::corrupted("no_tables_to_compact"))
        }

        auto iters# = Vec<SSTableIterator>::with_capacity(old_count)
        auto h_idx# = 0:usize
        loop h_idx < old_count {
            {
                auto &old_handle = old_handles.borrow(h_idx)
                auto it_res = SSTableIterator::open(old_handle.reader)
                if it_res.is_err() {
                    return Result<TableMetadata, KvError>::Err(it_res.unwrap_err())
                }
                auto it = it_res.unwrap()
                iters#.push(cede it)
            }
            h_idx = h_idx + 1:usize
        }

        auto merger# = MergingIterator::new(cede iters)
        auto deduped# = Vec<Entry>::new()
        auto current_group# = Vec<Entry>::new()
        auto current_key# = string::new()
        auto has_key# = false

        loop merger#.is_valid() {
            auto n_res = merger#.next_entry()
            if n_res.is_err() {
                return Result<TableMetadata, KvError>::Err(n_res.unwrap_err())
            }
            auto opt = n_res.unwrap()
            if opt.is_none() {
                break
            }
            auto entry = opt.unwrap()

            if has_key && !entry.key.as_str().equals(current_key.as_str()) {
                auto kept# = Compactor::filter_user_key_group(current_group, oldest_snapshot_opt)
                auto k_i# = 0:usize
                loop k_i < kept.len() {
                    {
                        auto &kept_entry = kept.borrow(k_i)
                        auto e = Entry(
                            key = kept_entry.key.clone(),
                            value = kept_entry.value.clone(),
                            seq = kept_entry.seq,
                            is_del = kept_entry.is_del
                        )
                        deduped#.push(cede e)
                    }
                    k_i = k_i + 1:usize
                }
                current_group = Vec<Entry>::new()
                current_key = entry.key.clone()
            }

            if !has_key {
                has_key = true
                current_key = entry.key.clone()
            }
            current_group#.push(cede entry)
        }

        if current_group.len() > 0:usize {
            auto kept# = Compactor::filter_user_key_group(current_group, oldest_snapshot_opt)
            auto k_i# = 0:usize
            loop k_i < kept.len() {
                {
                    auto &final_kept_entry = kept.borrow(k_i)
                    auto e = Entry(
                        key = final_kept_entry.key.clone(),
                        value = final_kept_entry.value.clone(),
                        seq = final_kept_entry.seq,
                        is_del = final_kept_entry.is_del
                    )
                    deduped#.push(cede e)
                }
                k_i = k_i + 1:usize
            }
        }

        if deduped.len() == 0:usize {
            return Result<TableMetadata, KvError>::Err(KvError::corrupted("cannot_create_empty_sstable"))
        }

        auto target_path = build_table_path(db_dir, new_file_number)
        auto w_res = SSTableWriter::write_entries(target_path, deduped)
        if w_res.is_err() {
            return Result<TableMetadata, KvError>::Err(w_res.unwrap_err())
        }

        auto meta# = w_res.unwrap()
        meta.file_number = new_file_number
        meta.level = 1:u32
        return Result<TableMetadata, KvError>::Ok(cede meta)
    }
}
