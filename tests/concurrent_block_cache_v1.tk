// tokakv/tests/concurrent_block_cache_v1.tk
// Multi-threaded stress test for BlockCache under concurrent hits, misses, double-check loads, and LRU evictions.

import std/io::{println}
import std/vec::{Vec}
import std/fs::{create_temp_file_system}
import std/thread::{thread_spawn_with_state, yield_now}
import official/tokakv::{TokaKvEngine}
import official/tokakv/types::{LookupResult}
import official/tokakv/cache/block_cache::{BlockCache}
import official/tokakv/manifest/version_set::{build_table_path}
import official/tokakv/sstable/reader::{SSTableReader}

fn make_key(i: usize) -> string {
    auto s# = string::from("key:")
    s#.push_str(string::from_int(i as i32).as_str())
    return cede s
}

fn make_val(i: usize) -> string {
    auto s# = string::from("value_data_")
    s#.push_str(string::from_int(i as i32).as_str())
    return cede s
}

shape CacheWorkerState (
    cache: BlockCache,
    path: string,
    key: string,
    expected: string,
    file_number: u64,
    offset: u64,
    length: u64,
    iterations: usize,
    strict#: bool
)

impl CacheWorkerState@Send {}

fn run_cache_worker(state: CacheWorkerState) -> cede i32 {
    auto iter# = 0:usize
    loop iter < state.iterations {
        auto loaded = state.cache.get_or_load(
            state.file_number,
            state.offset,
            state.length,
            state.path
        )
        if loaded.is_ok() {
            auto r = loaded.unwrap().lookup(state.key.as_str())
            match r {
                auto LookupResult::Hit(&val) => assert(
                    val.as_str().equals(state.expected.as_str()),
                    "cache worker value mismatch"
                )
                _ => {
                    if state.strict {
                        assert(false, "cache worker lookup failed")
                    }
                }
            }
        } else if state.strict {
            assert(false, "cache worker load failed")
        }
        yield_now()
        iter = iter + 1:usize
    }
    return cede 0
}

fn test_concurrent_double_check_miss() {
    auto tmp# = create_temp_file_system().unwrap()
    auto db_path# = tmp.path().clone()
    db_path#.push_str("_db")

    auto db# = TokaKvEngine::open(db_path.clone()).unwrap()
    auto k = string::from("alpha")
    auto v = string::from("val_alpha")
    db#.put(k, v).unwrap()
    db#.flush_active_memtable().unwrap()
    auto cur_v = db#.current_version()
    auto fnum = cur_v.get_table(0:usize).meta.file_number
    db#.close().unwrap()

    auto sst_path = build_table_path(db_path.clone(), fnum)
    auto r_open# = SSTableReader::open(sst_path.clone()).unwrap()
    auto b_cand = r_open#.find_candidate_block(string::from("alpha").as_str()).unwrap()
    auto b_offset = b_cand.offset
    auto b_length = b_cand.length

    auto cache = BlockCache::new(65536:usize)

    auto s1 = CacheWorkerState(
        cache = cache.clone(), path = sst_path.clone(), key = string::from("alpha"),
        expected = string::from("val_alpha"), file_number = fnum,
        offset = b_offset, length = b_length, iterations = 1:usize, strict = true
    )
    auto s2 = CacheWorkerState(
        cache = cache.clone(), path = sst_path.clone(), key = string::from("alpha"),
        expected = string::from("val_alpha"), file_number = fnum,
        offset = b_offset, length = b_length, iterations = 1:usize, strict = true
    )
    auto s3 = CacheWorkerState(
        cache = cache.clone(), path = sst_path.clone(), key = string::from("alpha"),
        expected = string::from("val_alpha"), file_number = fnum,
        offset = b_offset, length = b_length, iterations = 1:usize, strict = true
    )
    auto s4 = CacheWorkerState(
        cache = cache.clone(), path = sst_path.clone(), key = string::from("alpha"),
        expected = string::from("val_alpha"), file_number = fnum,
        offset = b_offset, length = b_length, iterations = 1:usize, strict = true
    )
    auto worker_entry = { state => return cede run_cache_worker(state) }:fn(CacheWorkerState) -> cede i32
    auto t1# = thread_spawn_with_state<CacheWorkerState, i32>(cede s1, worker_entry)
    auto t2# = thread_spawn_with_state<CacheWorkerState, i32>(cede s2, worker_entry)
    auto t3# = thread_spawn_with_state<CacheWorkerState, i32>(cede s3, worker_entry)
    auto t4# = thread_spawn_with_state<CacheWorkerState, i32>(cede s4, worker_entry)

    t1#.join().unwrap()
    t2#.join().unwrap()
    t3#.join().unwrap()
    t4#.join().unwrap()

    auto s = cache.stats()
    assert(s.resident_bytes > 0:usize, "Must have 1 resident block")
    assert(s.eviction_count == 0:u64, "Eviction count must be 0")

    tmp#.remove()
}

fn test_concurrent_hits_misses_evictions() {
    auto tmp# = create_temp_file_system().unwrap()
    auto db_path# = tmp.path().clone()
    db_path#.push_str("_db")

    auto db# = TokaKvEngine::open(db_path.clone()).unwrap()
    auto i# = 1:usize
    loop i <= 10:usize {
        auto k = make_key(i)
        auto v = make_val(i)
        db#.put(k, v).unwrap()
        i = i + 1:usize
    }
    db#.flush_active_memtable().unwrap() // Table 1

    loop i <= 20:usize {
        auto k = make_key(i)
        auto v = make_val(i)
        db#.put(k, v).unwrap()
        i = i + 1:usize
    }
    db#.flush_active_memtable().unwrap() // Table 2

    loop i <= 30:usize {
        auto k = make_key(i)
        auto v = make_val(i)
        db#.put(k, v).unwrap()
        i = i + 1:usize
    }
    db#.flush_active_memtable().unwrap() // Table 3

    loop i <= 40:usize {
        auto k = make_key(i)
        auto v = make_val(i)
        db#.put(k, v).unwrap()
        i = i + 1:usize
    }
    db#.flush_active_memtable().unwrap() // Table 4
    auto cur_v = db#.current_version()
    auto fnum1 = cur_v.get_table(0:usize).meta.file_number
    auto fnum2 = cur_v.get_table(1:usize).meta.file_number
    auto fnum3 = cur_v.get_table(2:usize).meta.file_number
    auto fnum4 = cur_v.get_table(3:usize).meta.file_number
    db#.close().unwrap()

    // Create tight cache (~2 blocks capacity)
    auto cache = BlockCache::new(3000:usize)

    auto sst1 = build_table_path(db_path.clone(), fnum1)
    auto sst2 = build_table_path(db_path.clone(), fnum2)
    auto sst3 = build_table_path(db_path.clone(), fnum3)
    auto sst4 = build_table_path(db_path.clone(), fnum4)

    auto r1# = SSTableReader::open(sst1.clone()).unwrap()
    auto c1_cand = r1#.find_candidate_block(string::from("key:5").as_str()).unwrap()
    auto off1 = c1_cand.offset
    auto len1 = c1_cand.length

    auto r2# = SSTableReader::open(sst2.clone()).unwrap()
    auto c2_cand = r2#.find_candidate_block(string::from("key:15").as_str()).unwrap()
    auto off2 = c2_cand.offset
    auto len2 = c2_cand.length

    auto r3# = SSTableReader::open(sst3.clone()).unwrap()
    auto c3_cand = r3#.find_candidate_block(string::from("key:25").as_str()).unwrap()
    auto off3 = c3_cand.offset
    auto len3 = c3_cand.length

    auto r4# = SSTableReader::open(sst4.clone()).unwrap()
    auto c4_cand = r4#.find_candidate_block(string::from("key:35").as_str()).unwrap()
    auto off4 = c4_cand.offset
    auto len4 = c4_cand.length

    auto s1 = CacheWorkerState(
        cache = cache.clone(), path = sst1.clone(), key = string::from("key:5"),
        expected = string::from("value_data_5"), file_number = fnum1,
        offset = off1, length = len1, iterations = 50:usize, strict = false
    )
    auto s2 = CacheWorkerState(
        cache = cache.clone(), path = sst2.clone(), key = string::from("key:15"),
        expected = string::from("value_data_15"), file_number = fnum2,
        offset = off2, length = len2, iterations = 50:usize, strict = false
    )
    auto s3 = CacheWorkerState(
        cache = cache.clone(), path = sst3.clone(), key = string::from("key:25"),
        expected = string::from("value_data_25"), file_number = fnum3,
        offset = off3, length = len3, iterations = 50:usize, strict = false
    )
    auto s4 = CacheWorkerState(
        cache = cache.clone(), path = sst4.clone(), key = string::from("key:35"),
        expected = string::from("value_data_35"), file_number = fnum4,
        offset = off4, length = len4, iterations = 50:usize, strict = false
    )
    auto worker_entry = { state => return cede run_cache_worker(state) }:fn(CacheWorkerState) -> cede i32
    auto w1# = thread_spawn_with_state<CacheWorkerState, i32>(cede s1, worker_entry)
    auto w2# = thread_spawn_with_state<CacheWorkerState, i32>(cede s2, worker_entry)
    auto w3# = thread_spawn_with_state<CacheWorkerState, i32>(cede s3, worker_entry)
    auto w4# = thread_spawn_with_state<CacheWorkerState, i32>(cede s4, worker_entry)

    w1#.join().unwrap()
    w2#.join().unwrap()
    w3#.join().unwrap()
    w4#.join().unwrap()

    auto s = cache.stats()
    assert(s.hit_count > 0:u64, "Must record hits during concurrent execution")
    assert(s.miss_count > 0:u64, "Must record misses during concurrent execution")

    tmp#.remove()
}

fn main() -> i32 {
    test_concurrent_double_check_miss()
    test_concurrent_hits_misses_evictions()
    println("[PASS] Concurrent Block Cache v1 Stress Tests Qualified Successfully!")
    return 0
}
