// tokakv/tests/concurrent_wal_rotation_read_write_v1.tk
// Multi-threaded stress test: concurrent readers, writers, WAL rotations, and MemTable flushes.

import std/io::{println}
import std/fs::{create_temp_file_system}
import std/thread::{thread_spawn_with_state, yield_now}
import official/tokakv::{TokaKvEngine}

fn make_key(i: usize) -> string {
    auto s# = string::from("rot_key_")
    s#.push_str(string::from_int(i as i32).as_str())
    return cede s
}

fn make_val(i: usize, iter: usize) -> string {
    auto s# = string::from("rot_val_")
    s#.push_str(string::from_int(i as i32).as_str())
    s#.push_str("_iter_")
    s#.push_str(string::from_int(iter as i32).as_str())
    return cede s
}

fn run_reader_1(db: TokaKvEngine) -> cede i32 {
    auto iter# = 0:usize
    loop iter < 50:usize {
        auto k_idx# = 1:usize
        loop k_idx <= 25:usize {
            auto res = db.get(make_key(k_idx))
            assert(res.is_ok(), "r1 get must succeed")
            k_idx = k_idx + 1:usize
        }
        yield_now()
        iter = iter + 1:usize
    }
    return cede 0
}

fn run_reader_2(db: TokaKvEngine) -> cede i32 {
    auto iter# = 0:usize
    loop iter < 50:usize {
        auto k_idx# = 26:usize
        loop k_idx <= 50:usize {
            auto res = db.get(make_key(k_idx))
            assert(res.is_ok(), "r2 get must succeed")
            k_idx = k_idx + 1:usize
        }
        yield_now()
        iter = iter + 1:usize
    }
    return cede 0
}

fn run_reader_3(db: TokaKvEngine) -> cede i32 {
    auto iter# = 0:usize
    loop iter < 50:usize {
        auto k_idx# = 51:usize
        loop k_idx <= 100:usize {
            auto res = db.get(make_key(k_idx))
            assert(res.is_ok(), "r3 get must succeed")
            k_idx = k_idx + 1:usize
        }
        yield_now()
        iter = iter + 1:usize
    }
    return cede 0
}

fn run_reader_4(db: TokaKvEngine) -> cede i32 {
    auto iter# = 0:usize
    loop iter < 50:usize {
        auto k_idx# = 1:usize
        loop k_idx <= 100:usize {
            auto res = db.get(make_key(k_idx))
            assert(res.is_ok(), "r4 get must succeed")
            k_idx = k_idx + 2:usize
        }
        yield_now()
        iter = iter + 1:usize
    }
    return cede 0
}

fn run_writer_1(db: TokaKvEngine) -> cede i32 {
    auto iter# = 1:usize
    loop iter <= 20:usize {
        auto k_idx# = 51:usize
        loop k_idx <= 100:usize {
            auto p_res = db.put(make_key(k_idx), make_val(k_idx, iter))
            if p_res.is_err() {
                auto err = p_res.unwrap_err()
                println("w1 put error: kind={} code={} message={}", err.kind, err.code, err.message)
                assert(false, "w1 put must succeed")
            }
            k_idx = k_idx + 1:usize
        }
        yield_now()
        iter = iter + 1:usize
    }
    return cede 0
}

fn run_writer_2(db: TokaKvEngine) -> cede i32 {
    auto iter# = 1:usize
    loop iter <= 20:usize {
        auto k_idx# = 1:usize
        loop k_idx <= 50:usize {
            auto p_res = db.put(make_key(k_idx), make_val(k_idx, iter))
            if p_res.is_err() {
                auto err = p_res.unwrap_err()
                println("w2 put error: kind={} code={} message={}", err.kind, err.code, err.message)
                assert(false, "w2 put must succeed")
            }
            k_idx = k_idx + 1:usize
        }
        yield_now()
        iter = iter + 1:usize
    }
    return cede 0
}

fn run_rotator(db: TokaKvEngine) -> cede i32 {
    auto r_step# = 0:usize
    loop r_step < 8:usize {
        yield_now()
        auto rot_res = db.rotate_wal()
        if rot_res.is_err() {
            auto err = rot_res.unwrap_err()
            println("rotate error: kind={} code={} message={}", err.kind, err.code, err.message)
            assert(false, "rotate_wal in thread must succeed")
        }
        yield_now()
        if r_step % 2:usize == 0:usize {
            auto fl_res = db.flush_active_memtable()
            if fl_res.is_err() {
                auto err = fl_res.unwrap_err()
                println("flush error: kind={} code={} message={}", err.kind, err.code, err.message)
                assert(false, "flush_active_memtable in rotator thread must succeed")
            }
        }
        r_step = r_step + 1:usize
    }
    return cede 0
}

fn test_concurrent_rotation_read_write() {
    auto tmp# = create_temp_file_system().unwrap()
    auto db_path# = tmp.path().clone()
    db_path#.push_str("_db")

    auto db# = TokaKvEngine::open(db_path.clone()).unwrap()

    // Pre-populate 50 keys
    auto i# = 1:usize
    loop i <= 50:usize {
        db#.put(make_key(i), make_val(i, 0)).unwrap()
        i = i + 1:usize
    }

    // Flush initial batch to SSTable
    db#.flush_active_memtable().unwrap()

    auto r1_db = db.clone()
    auto r2_db = db.clone()
    auto r3_db = db.clone()
    auto r4_db = db.clone()
    auto w1_db = db.clone()
    auto w2_db = db.clone()
    auto rot_db = db.clone()

    auto r1_entry = { state => return cede run_reader_1(state) }:fn(TokaKvEngine) -> cede i32
    auto r2_entry = { state => return cede run_reader_2(state) }:fn(TokaKvEngine) -> cede i32
    auto r3_entry = { state => return cede run_reader_3(state) }:fn(TokaKvEngine) -> cede i32
    auto r4_entry = { state => return cede run_reader_4(state) }:fn(TokaKvEngine) -> cede i32
    auto w1_entry = { state => return cede run_writer_1(state) }:fn(TokaKvEngine) -> cede i32
    auto w2_entry = { state => return cede run_writer_2(state) }:fn(TokaKvEngine) -> cede i32
    auto rot_entry = { state => return cede run_rotator(state) }:fn(TokaKvEngine) -> cede i32
    auto t_r1# = thread_spawn_with_state<TokaKvEngine, i32>(cede r1_db, r1_entry)
    auto t_r2# = thread_spawn_with_state<TokaKvEngine, i32>(cede r2_db, r2_entry)
    auto t_r3# = thread_spawn_with_state<TokaKvEngine, i32>(cede r3_db, r3_entry)
    auto t_r4# = thread_spawn_with_state<TokaKvEngine, i32>(cede r4_db, r4_entry)
    auto t_w1# = thread_spawn_with_state<TokaKvEngine, i32>(cede w1_db, w1_entry)
    auto t_w2# = thread_spawn_with_state<TokaKvEngine, i32>(cede w2_db, w2_entry)
    auto t_rot# = thread_spawn_with_state<TokaKvEngine, i32>(cede rot_db, rot_entry)

    t_r1#.join().unwrap()
    t_r2#.join().unwrap()
    t_r3#.join().unwrap()
    t_r4#.join().unwrap()
    t_w1#.join().unwrap()
    t_w2#.join().unwrap()
    t_rot#.join().unwrap()

    // Final check
    auto check# = 1:usize
    loop check <= 100:usize {
        auto res = db#.get(make_key(check)).unwrap()
        assert(res.is_some(), "All keys 1..100 must be present")
        check = check + 1:usize
    }

    db#.close().unwrap()
    tmp#.remove()
}

fn main() -> i32 {
    test_concurrent_rotation_read_write()
    println("[PASS] Concurrent WAL Rotation Read/Write Stress Tests Qualified Successfully!")
    return 0
}
